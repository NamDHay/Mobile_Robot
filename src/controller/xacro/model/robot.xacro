<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_robot" >

  <xacro:arg name="use_nominal_extrinsics" default="false"/>
  <xacro:arg name="add_plug" default="false" />
  <xacro:arg name="use_mesh" default="true" />

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find controller)/xacro/materials.xacro" />

  <!-- Robot Body -->
  <xacro:include filename="$(find controller)/xacro/model/robot_body.xacro"/>
  <xacro:robot_body name="chassis" parent="base_link" meshes="package://gazebo_plugins/test/controller/meshes/model"/>

  <!-- Laser -->
  <xacro:include filename="$(find controller)/xacro/laser/hokuyo.xacro"/>
  <xacro:laser name="laser" parent="chassis" xyz="0.175 0 0.175" rpy="0 0 1.5708" meshes="package://gazebo_plugins/test/drl/meshes/laser"/>

</robot>
