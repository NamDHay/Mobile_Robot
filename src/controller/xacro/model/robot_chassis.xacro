<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <property name="M_PI" value="3.1415926535897931" />
  <xacro:include filename="inertial_macros.xacro"/>

  <xacro:property name="half_pi_const" value="1.5707963" />
<xacro:property name="body_link_x_dim" value="0.55" />
<xacro:property name="body_link_y_dim" value="0.45" />
<xacro:property name="body_link_z_dim" value="0.09" />
  <xacro:macro name="base_chassis" params="name parent xyz rpy meshes">

  <!-- Chassis -->
  <joint name="${parent}_${name}_joint" type="fixed">
    <origin xyz="0.0 0 0" />
    <parent link="${parent}"/>
    <child link="chassis"/>
  </joint>

<link name="chassis">
    <visual>
        <origin xyz="0.0 0 0.08" rpy="0 0 0"/>
        <geometry>
            <box size="0.55 0.45 0.15"/>
        </geometry>
          <material name="orange"/>
    </visual>
    <collision>
        <origin xyz="0.0 0 0.08" rpy="0 0 0"/>
        <geometry>
            <box size="0.55 0.45 0.15"/>
        </geometry>
    </collision>
    <xacro:inertial_box mass="15" x="0.55" y="0.45" z="0.15">
        <origin xyz="0.0 0 0.08" rpy="0 0 0"/>
    </xacro:inertial_box>
</link>

    <gazebo reference="chassis">
        <material>Gazebo/Orange</material>
    </gazebo>
  </xacro:macro>

</robot>
