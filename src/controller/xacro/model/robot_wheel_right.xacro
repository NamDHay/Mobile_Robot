<?xml version="1.0"?>
<robot
  xmlns:xacro="http://ros.org/wiki/xacro">
  <property name="M_PI" value="3.1415926535897931" />
  <xacro:include filename="inertial_macros.xacro"/>
  <xacro:property name="wheel_link_radius" value="0.05" />
  <xacro:property name="wheel_link_length" value="0.02" />
  <xacro:property name="wheel_link_x_location" value="0.12" />
  <xacro:property name="sphere_radius" value="0.02" />
  <xacro:property name="sphere_joint_y" value="-0.15" />
  <xacro:property name="z_sphere" value="-0.017" />
  <xacro:property name="pi_const" value="3.1415926535898" />
  <xacro:property name="half_pi_const" value="1.5707963" />
<xacro:property name="chassis_mass" value="10.0"/>
<xacro:property name="wheel_mass" value="0.2"/>
<xacro:property name="caster_wheel_mass" value="0.01"/>

  <xacro:macro name="base_wheel_right" params=" parent xyz rpy radius meshes">

  <!-- Hubcap --> 
<joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.18 0.0415" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 -1"/>
</joint>

  <link name="right_wheel">
    <visual>
        <geometry>
            <cylinder length="0.02" radius="0.05" />
        </geometry>
        <material name="blue"/>
    </visual>
	<collision>
		<geometry>
            <cylinder length="0.02" radius="0.05" />
        </geometry>
        <material name="blue"/>
	</collision>
    <xacro:inertial_cylinder mass="0.1" length="0.02" radius="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
</link>
    <gazebo reference="right_wheel">
        <material>Gazebo/Blue</material>
    </gazebo>

  </xacro:macro>

</robot>
